/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	:root {
		@apply bg-black text-white w-screen;
	}
	html {
		@apply text-white font-kanit block;
	}
}

@layer components {
	.main-wrapper {
		@apply rounded-lg p-4 bg-dark;
	}

	.custom-scroll::-webkit-scrollbar-track {
		@apply bg-dark;
	}
	.custom-scroll::-webkit-scrollbar-thumb {
		background: #d3d3d3;
	}
	.custom-scroll::-webkit-scrollbar {
		@apply hidden;
	}
}
